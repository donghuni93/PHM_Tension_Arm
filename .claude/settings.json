{
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "PowerShell(git status *)",
      "PowerShell(git log *)",
      "PowerShell(git diff *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh\""
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "echo '컨텍스트가 방금 압축됐다. 다른 작업 전에 사용자에게 /handoff로 인수인계 노트를 저장할지 AskUserQuestion으로 묻는다.'"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "echo '요약에 반드시 남길 것: 현재 자동화 단계, 진행 중인 계획 단계, 사용자 승인을 기다리는 항목, 아직 vault에 저장하지 않은 결정과 그 이유.'"
          }
        ]
      }
    ]
  }
}
